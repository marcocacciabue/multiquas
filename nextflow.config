docker.enabled = true
trace.overwrite = true
process {
  resourceLimits = [
    cpus: 12,
    memory: 15.GB,
    time: 2.h
  ]
  errorStrategy = { task.attempt < 3 ? 'retry' : 'ignore' }
  maxRetries = 1

  withLabel:process_low {
    cpus   = { 2      * task.attempt }
    time   = { 4.min  * task.attempt }
    memory = 2.GB
  }
  withLabel:process_medium {
    cpus   = { 4     * task.attempt }
    time   = { 8.min * task.attempt }
    memory = 4.GB
    maxForks = 4
  }
  withLabel:process_high {
    cpus   = 4
    memory = { 6.GB   * task.attempt }
    time   = { 10.min * task.attempt }
    maxForks = 4
  }
}

// reports
timeline {
  enabled = true
  overwrite = true
  file = "multiquas.html"
}
report {
  enabled = true
  overwrite = true
  file = "multiquas_report.html"
}


profiles {

  'complete' {
    includeConfig 'conf/complete.config'
  }
  'fast' {
    includeConfig 'conf/fast.config'
  }
  'single' {
    includeConfig 'conf/single.config'
  }
  'multiple' {
    includeConfig 'conf/multiple.config'
  }
 }